# Neon PostgreSQL Database URLs
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.us-west-2.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production

# Neon Auth
NEON_AUTH_BASE_URL=https://ep-example.neonauth.us-west-2.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-example.neonauth.us-west-2.aws.neon.tech/neondb/auth/.well-known/jwks.json
VITE_NEON_AUTH_URL=https://ep-example.neonauth.us-west-2.aws.neon.tech/neondb/auth

# Application Security
JWT_SECRET_KEY=generate_a_random_32_character_string_here

# AI & APIs
GEMINI_API_KEY=your_gemini_api_key_here
HUGGINGFACE=your_huggingface_token_here
PIXELAPI=your_pixelapi_key_here

# Cloudinary (Optional - For Cloud Image Storage)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
